# ---------------------------------------------------------------------------
# Local state and secrets. Never commit these.
# ---------------------------------------------------------------------------
#
# The whole .orchestrator/ directory is local state by convention: it holds
# state.db, which carries every objective, result, and audit trail this
# machine has produced. An example configuration lives in
# examples/config.development.yaml instead, so nothing here needs tracking.
.orchestrator/

.env
.env.*
*.key
*.pem
secrets.*
*.keys.json

# Backups and databases anywhere in the tree.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak

# ---------------------------------------------------------------------------
# Build and tool output
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments. `python -m venv` writes a self-ignoring .gitignore
# inside the directory it creates, but virtualenv and older tools do not, so
# name them here rather than depend on that.
.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Evaluation and scan artefacts
evaluation-report.json
requirements-audit.txt
evaluation-report.md
sbom.json
image-digest.txt

# Deployment runtime output
deployment/backups/
deployment/caddy-data/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Output from using the application
# ---------------------------------------------------------------------------
#
# The development workspace defaults to ".", so an orchestrated run publishes
# its artifacts into the repository root. These two directories are what this
# machine produced while the platform was being exercised: they are output,
# not source, and without naming them `git add -A` picks them up.
/tetris/
/tic-tac-toe/
